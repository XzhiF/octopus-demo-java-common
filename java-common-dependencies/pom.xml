<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.octopus.demo</groupId>
        <artifactId>octopus-demo-java-common</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>java-common-dependencies</artifactId>
    <packaging>pom</packaging>
    <name>java-common-dependencies</name>
    <description>BOM module for managing dependency versions across octopus-demo projects</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- JWT library -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>0.12.6</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>0.12.6</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>0.12.6</version>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.octopus.demo</groupId>
                <artifactId>java-common-bean</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.octopus.demo</groupId>
                <artifactId>java-common-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.octopus.demo</groupId>
                <artifactId>java-common-util</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.octopus.demo</groupId>
                <artifactId>java-common-health</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.octopus.demo</groupId>
                <artifactId>java-common-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>